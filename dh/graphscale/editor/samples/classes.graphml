<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:y="http://www.yworks.com/xml/graphml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <key for="graphml" id="d0" yfiles.type="resources"/>
  <key attr.name="url" attr.type="string" for="node" id="d1"/>
  <key attr.name="description" attr.type="string" for="node" id="d2"/>
  <key for="node" id="d3" yfiles.type="nodegraphics"/>
  <key attr.name="url" attr.type="string" for="edge" id="d4"/>
  <key for="edge" id="d6" yfiles.type="edgegraphics"/>
  <graph edgedefault="directed" id="G">
    <node id="n0">
      <data key="d1">docs/shape.html</data>
      <data key="d3">
        <y:UMLClassNode>
          <y:Geometry height="90.0" width="130.0" x="150.0" y="30.0"/>
          <y:Fill color="#FFCC00" transparent="false"/>
          <y:NodeLabel>Shape</y:NodeLabel>
          <y:UML clipContent="true" omitDetails="false" stereotype="abstract" use3DEffect="false">
            <y:AttributeLabel>- name: String
- x: double</y:AttributeLabel>
            <y:MethodLabel>+ area(): double
+ draw(): void</y:MethodLabel>
          </y:UML>
        </y:UMLClassNode>
      </data>
    </node>
    <node id="n1">
      <data key="d3">
        <y:UMLClassNode>
          <y:Geometry height="70.0" width="120.0" x="40.0" y="220.0"/>
          <y:Fill color="#99CCFF" transparent="false"/>
          <y:NodeLabel>Circle</y:NodeLabel>
          <y:UML clipContent="true" omitDetails="false" stereotype="" use3DEffect="false">
            <y:AttributeLabel>- radius: double</y:AttributeLabel>
            <y:MethodLabel>+ area(): double</y:MethodLabel>
          </y:UML>
        </y:UMLClassNode>
      </data>
    </node>
    <node id="n2">
      <data key="d3">
        <y:UMLClassNode>
          <y:Geometry height="70.0" width="120.0" x="260.0" y="220.0"/>
          <y:Fill color="#99CCFF" transparent="false"/>
          <y:NodeLabel>Rectangle</y:NodeLabel>
          <y:UML clipContent="true" omitDetails="false" stereotype="" use3DEffect="false">
            <y:AttributeLabel>- w: double
- h: double</y:AttributeLabel>
            <y:MethodLabel>+ area(): double</y:MethodLabel>
          </y:UML>
        </y:UMLClassNode>
      </data>
    </node>
    <node id="n3">
      <data key="d3">
        <y:ShapeNode>
          <y:Geometry height="30.0" width="30.0" x="480.0" y="50.0"/>
          <y:Fill color="#FF9999" transparent="false"/>
          <y:NodeLabel>Canvas</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>
    <edge id="e0" source="n1" target="n0">
      <data key="d6">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"/>
          <y:LineStyle color="#000000" type="line" width="1.0"/>
          <y:Arrows source="none" target="white_delta"/>
          <y:EdgeLabel>extends</y:EdgeLabel>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e1" source="n2" target="n0">
      <data key="d6">
        <y:PolyLineEdge>
          <y:LineStyle color="#000000" type="line" width="1.0"/>
          <y:Arrows source="none" target="white_delta"/>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e2" source="n3" target="n0">
      <data key="d6">
        <y:PolyLineEdge>
          <y:LineStyle color="#000000" type="dashed" width="1.0"/>
          <y:Arrows source="none" target="standard"/>
          <y:EdgeLabel>draws</y:EdgeLabel>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e3" source="n3" target="n3">
      <data key="d6">
        <y:PolyLineEdge>
          <y:LineStyle color="#000000" type="line" width="1.0"/>
          <y:Arrows source="none" target="none"/>
        </y:PolyLineEdge>
      </data>
    </edge>
  </graph>
</graphml>
