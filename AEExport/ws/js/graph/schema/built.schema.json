{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Built graph (data/graphs/*.json) – generated by build-graph.mjs, do not edit",
  "type": "object",
  "required": ["version", "groups", "nodes", "edges"],
  "properties": {
    "version": { "const": 1 },
    "groups": { "type": "object" },
    "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "label"], "properties": {
      "id": { "type": "string" }, "label": { "type": "string" }, "sub": { "type": "string" }, "type": { "type": "string" },
      "group": { "type": "string" }, "href": { "type": "string" }, "src": { "enum": ["foundry", "npcs", "overlay"] },
      "pos": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 } } } },
    "edges": { "type": "array", "items": { "type": "object", "required": ["source", "target"] } }
  }
}
