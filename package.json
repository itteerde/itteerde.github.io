{
  "name": "ws-tools",
  "private": true,
  "scripts": {
    "search:dh-ae": "pagefind --site AEExport/ws --output-subdir pagefind",
    "search:dh-coa": "pagefind --site dh/coa --output-subdir pagefind",
    "search:dh-aou": "pagefind --site dh/aou --output-subdir pagefind",
    "search": "npm run search:dh-ae && npm run search:dh-coa && npm run search:dh-aou",
    "preview": "npm run search && npx --yes serve .",
    "graph": "node _src/node/build-graph.mjs",
    "graph:test": "node _src/node/test-graph.mjs",
    "vendor": "node _src/node/vendor-three.mjs"
  },
  "devDependencies": {
    "pagefind": "^1.6.0",
    "three": "^0.187.0"
  }
}
